HOST=127.0.0.1
PORT=3000
TRUSTED_PROXY_ADDRESSES=127.0.0.1
DATABASE_URL=postgresql://application_login:replace-with-secret@127.0.0.1:5432/creative_intelligence?options=-c%20role%3Dcreative_intelligence_runtime
DATABASE_RUNTIME_ROLE=creative_intelligence_runtime
DATABASE_CONNECT_TIMEOUT_MS=2000
DATABASE_HEALTH_TIMEOUT_MS=500
DATABASE_POOL_MAX=10
CURSOR_SIGNING_KEY=replace-with-at-least-32-random-bytes
OIDC_ISSUER=https://identity.example.com/
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_AUDIENCES=creative-api
OIDC_ALGORITHMS=RS256
OIDC_IDENTITY_NAMESPACE=creative_oidc
OIDC_CLOCK_TOLERANCE_SECONDS=5
OIDC_JWKS_TIMEOUT_MS=2000
OIDC_JWKS_CACHE_TTL_MS=300000
OIDC_MAX_JWKS_BYTES=65536
OIDC_MAX_JWKS_KEYS=20
OIDC_SUBJECT_MAX_LENGTH=128
# Optional single-user staging login. Keep disabled for production and load both secrets from protected files.
# STAGING_PASSWORD_LOGIN_ENABLED=true
# STAGING_LOGIN_PASSWORD_HASH_FILE=/run/credentials/staging-password-hash
# STAGING_LOGIN_PRIVATE_KEY_FILE=/run/credentials/staging-oidc-private-key
# STAGING_LOGIN_KEY_ID=staging-key-1
# STAGING_LOGIN_SUBJECT=staging-user
# STAGING_LOGIN_ORGANIZATION_ID=staging-org
# STAGING_LOGIN_TOKEN_TTL_SECONDS=43200
# STAGING_LOGIN_MAX_ATTEMPTS=5
# STAGING_LOGIN_ATTEMPT_WINDOW_MS=300000
# STAGING_LOGIN_MAX_CONCURRENCY=2
APIFY_API_TOKEN=replace-with-apify-token
APIFY_TIMEOUT_MS=60000
APIFY_MAX_RESPONSE_BYTES=5000000
APIFY_AD_COUNT=100
APIFY_COUNTRY_CODE=ALL
APIFY_ACTIVE_STATUS=ACTIVE
APIFY_MAX_CONCURRENCY=2
