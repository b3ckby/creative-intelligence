{
  "name": "creative-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "preview:web": "vite preview --config vite.config.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "check:openapi": "tsx scripts/check-openapi.ts",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:web": "vitest run --config vite.config.ts",
    "test:postgres": "tsx --test --test-concurrency=1 tests/postgres/*.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --project tsconfig.web.json",
    "check": "npm run check:openapi && npm run typecheck && npm run typecheck:web && npm run test:unit && npm run test:web && npm run build:web && npm run test:postgres"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "jose": "6.2.13",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  }
}
