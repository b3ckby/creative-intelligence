{
  "name": "creative-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "check:openapi": "tsx scripts/check-openapi.ts",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:postgres": "tsx --test --test-concurrency=1 tests/postgres/*.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:openapi && npm run typecheck && npm run test:unit && npm run test:postgres"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "jose": "6.2.13",
    "pg": "^8.23.1",
    "tsx": "4.23.15"
  }
}
